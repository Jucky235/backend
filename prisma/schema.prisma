datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// --- ENUMS ---
// ==========================================

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

enum ExamCategory {
  TOEIC
  IELTS
  GENERAL
}

enum ExamStatus {
  ACTIVE
  INACTIVE
  OUTDATED
}

enum QuestionStatus {
  ACTIVE
  INACTIVE
}

enum DeckStatus {
  ACTIVE
  INACTIVE
}

enum DeckVisibility {
  PRIVATE // Only accessible/visible to the user who created it
  PUBLIC // Openly discoverable/studiable by all platform members
}

enum BoxLevel {
  BOX_1 // Review every day
  BOX_2 // Review every 2 days
  BOX_3 // Review every 4 days
  BOX_4 // Review every 7 days
  BOX_5 // Review every 15 days
  BOX_6 // Review every 30 days
  BOX_7 // Fully mastered / retired
}

enum PermissionScope {
  SYSTEM_WISE
  USER_WISE
}

// News
enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NewsCategory {
  GENERAL
  EXAM_TIPS
  ANNOUNCEMENT
  SYSTEM_UPDATE
  FEATURED
}

// ==========================================
// --- MODELS ---
// ==========================================

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  password      String? // Optional to support Google OAuth
  name          String
  phoneNumber   String?
  gender        Gender?
  provider      AuthProvider  @default(EMAIL)
  refreshTokens String[]
  examHistories ExamHistory[]

  // Flashcard System Creator Mapping
  createdDecks Deck[]      @relation("DeckCreator")
  createdCards Flashcard[] @relation("FlashcardCreator")

  // Flashcard Progress Tracker Maps
  flashcardProgressions FlashcardProgress[]
  deckProgressions      UserDeckProgress[]

  // Role relation
  roleId Int?
  role   Role? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Exam {
  id        String         @id @default(uuid())
  name      String
  category  ExamCategory
  time      Int // Duration in minutes or seconds
  status    ExamStatus     @default(ACTIVE)
  parts     ExamPart[] // Multi-part structure (e.g. Part 1, Part 2, Part 3...)
  questions ExamQuestion[] // Explicit link to individual questions
  histories ExamHistory[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

// ==========================================
// --- EXAM PART MODEL (NEW) ---
// ==========================================
model ExamPart {
  id           String         @id @default(uuid())
  examId       String
  exam         Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  partNumber   Int // e.g. 1, 2, 3...
  name         String // e.g. "Part 1: Photographs", "Part 2: Question-Response"
  instructions String?        @db.Text
  audioPath    String? // Optional global audio file for the entire part (e.g. TOEIC Listening)
  sortOrder    Int            @default(1)
  questions    ExamQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, partNumber])
  @@index([examId])
}

model Question {
  id             String         @id @default(uuid())
  content        String         @db.Text
  options        Json // Structured JSON for answer choices
  right_answer   String
  category       ExamCategory
  partNumber     Int? // ADDED: General default Part Number classification (e.g. 1 for TOEIC Part 1)
  explanation    String?        @db.Text
  status         QuestionStatus @default(ACTIVE)
  topicNumber    Int?
  imagePath      String?
  audioPath      String?
  exams          ExamQuestion[] // Explicit link to the join table
  lastEditedById String?
  lastEditedBy   Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model ExamQuestion {
  examId     String
  exam       Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionId String
  question   Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  // Optional direct link to an ExamPart
  partId     String?
  part       ExamPart? @relation(fields: [partId], references: [id], onDelete: SetNull)

  // Metadata specific to how the question sits inside a particular exam
  sortOrder  Int // e.g. 1, 2, 3... defines the exact question sequence
  partNumber Int? // e.g., TOEIC Part 1, Part 2...

  @@id([examId, questionId])
  @@index([questionId])
  @@index([examId, partNumber])
}

model ExamHistory {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  examId           String
  exam             Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  score            Int
  totalQuestions   Int
  correctQuestions Int
  isPassed         Boolean
  answers          Json // Store user answers AND question snapshots
  startedAt        DateTime
  submittedAt      DateTime
  timeTakenSeconds Int
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([examId])
}

// ==========================================
// --- FLASHCARDS MODELS ---
// ==========================================

model Deck {
  id          String         @id @default(uuid())
  name        String
  description String?        @db.Text
  category    ExamCategory
  status      DeckStatus     @default(ACTIVE)
  visibility  DeckVisibility @default(PRIVATE)

  creatorId String?
  creator   User?   @relation("DeckCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  cards        Flashcard[]
  progressions UserDeckProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
}

model Flashcard {
  id           String   @id @default(uuid())
  deckId       String
  deck         Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  frontContent String   @db.Text
  backContent  String   @db.Text
  explanation  String?  @db.Text
  imagePath    String?
  audioPath    String?
  partNumber   Int? // Optional segment context (e.g. TOEIC context rules)

  status DeckStatus @default(ACTIVE)

  creatorId String?
  creator   User?   @relation("FlashcardCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  userProgresses FlashcardProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deckId])
  @@index([creatorId])
}

model FlashcardProgress {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcardId  String
  flashcard    Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  box          BoxLevel @default(BOX_1)
  intervalDays Int      @default(1)
  easeFactor   Float    @default(2.5)
  repetitions  Int      @default(0)

  nextReviewAt   DateTime  @default(now())
  lastReviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, flashcardId])
  @@index([userId, nextReviewAt])
}

model UserDeckProgress {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deckId           String
  deck             Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)

  totalCardsViewed Int      @default(0)
  masteredCards    Int      @default(0)
  lastStudiedAt    DateTime @default(now())

  @@unique([userId, deckId])
}

// ==========================================
// --- ROLE & PERMISSION MODELS ---
// ==========================================

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique @db.VarChar(50)
  description String?      @db.Text
  permissions Permission[]
  users       User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id         Int              @id @default(autoincrement())
  roleId     Int
  role       Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  resource   String
  scope      PermissionScope
  permission PermissionAction
  allowed    Boolean          @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, scope, permission, resource])
}

// ==========================================
// --- NEWS & ANNOUNCEMENT MODELS ---
// ==========================================

model News {
  id          String            @id @default(uuid())
  title       String
  slug        String            @unique
  summary     String?           @db.Text
  content     String            @db.Text
  thumbnail   String?
  category    NewsCategory      @default(GENERAL)
  status      NewsStatus        @default(DRAFT)
  viewsCount  Int               @default(0)
  authorName  String?           @default("Admin")
  tags        NewsTagRelation[]

  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, publishedAt])
}

model NewsTag {
  id        Int               @id @default(autoincrement())
  name      String            @unique @db.VarChar(50)
  slug      String            @unique
  news      NewsTagRelation[]

  createdAt DateTime          @default(now())
}

model NewsTagRelation {
  newsId String
  news   News    @relation(fields: [newsId], references: [id], onDelete: Cascade)
  tagId  Int
  tag    NewsTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([newsId, tagId])
  @@index([tagId])
}
