datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// --- ENUMS ---
// ==========================================

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

enum ExamCategory {
  TOEIC
}

enum ExamStatus {
  ACTIVE
  INACTIVE
  OUTDATED
}

enum QuestionStatus {
  ACTIVE
  INACTIVE
}

// ==========================================
// --- MODELS ---
// ==========================================

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String         
  name          String
  phoneNumber   String?       
  gender        Gender?        
  provider      AuthProvider   @default(EMAIL)
  refreshTokens String[]
  examHistories ExamHistory[]  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Exam {
  id            String         @id @default(uuid())
  name          String
  category      ExamCategory 
  time          Int            
  status        ExamStatus     @default(ACTIVE)
  questions     Question[]     
  histories     ExamHistory[]  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Question {
  id             String         @id @default(uuid())
  content        String         @db.Text
  options        Json          
  right_answer   String
  category       ExamCategory
  explanation    String?        @db.Text
  status         QuestionStatus @default(ACTIVE)
  topicNumber    Int?           
  exams          Exam[]         
  lastEditedById String?
  lastEditedBy   Json?         
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model ExamHistory {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade) 
  examId           String
  exam             Exam     @relation(fields: [examId], references: [id], onDelete: Cascade) 
  score            Int
  totalQuestions   Int
  correctQuestions Int
  isPassed         Boolean  
  answers          Json
  startedAt        DateTime 
  submittedAt      DateTime 
  timeTakenSeconds Int
  createdAt        DateTime @default(now())
}
