datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// --- ENUMS ---
// ==========================================

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

enum ExamCategory {
  TOEIC
  IELTS
  GENERAL
}

enum ExamStatus {
  ACTIVE
  INACTIVE
  OUTDATED
}

enum QuestionStatus {
  ACTIVE
  INACTIVE
}

enum DeckStatus {
  ACTIVE
  INACTIVE
}

enum DeckVisibility {
  PRIVATE // Only accessible/visible to the user who created it
  PUBLIC // Openly discoverable/studiable by all platform members
}

enum BoxLevel {
  BOX_1 // Review every day
  BOX_2 // Review every 2 days
  BOX_3 // Review every 4 days
  BOX_4 // Review every 7 days
  BOX_5 // Review every 15 days
  BOX_6 // Review every 30 days
  BOX_7 // Fully mastered / retired
}

enum PermissionScope {
  SYSTEM_WISE
  USER_WISE
}

// News
enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NewsCategory {
  GENERAL
  EXAM_TIPS
  ANNOUNCEMENT
  SYSTEM_UPDATE
  FEATURED
}

enum ChannelStatus{
  ACTIVE
  ARCHIVED
}

// Forum
enum PostStatus {
  PUBLISHED
  ARCHIVED
  LOCKED
  HIDDEN
}

enum VoteType {
  UPVOTE
  DOWNVOTE
}

// ==========================================
// --- MODELS ---
// ==========================================

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  password      String? // Optional to support Google OAuth
  name          String
  phoneNumber   String?
  gender        Gender?
  provider      AuthProvider  @default(EMAIL)
  refreshTokens String[]
  examHistories ExamHistory[]

  // Flashcard System Creator Mapping
  createdDecks Deck[]      @relation("DeckCreator")
  createdCards Flashcard[] @relation("FlashcardCreator")

  // Flashcard Progress Tracker Maps
  flashcardProgressions FlashcardProgress[]
  deckProgressions      UserDeckProgress[]

  // Role relation
  roleId Int?
  role   Role? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  // Chat relation
  chatMessages ChatMessage[]

  //Forum relation
  authoredPosts    ForumPost[]        @relation("PostAuthor")
  authoredComments ForumComment[]     @relation("CommentAuthor")
  postVotes        ForumPostVote[]
  commentVotes     ForumCommentVote[]
  savedPosts       SavedPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// --- EXAM & QUESTION MODELS ---
// ==========================================

model Exam {
  id        String        @id @default(uuid())
  name      String
  category  ExamCategory
  time      Int // Duration in minutes or seconds
  status    ExamStatus    @default(ACTIVE)
  parts     ExamPart[] // Multi-part structure (e.g. Part 1, Part 2...)
  histories ExamHistory[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ExamPart {
  id           String         @id @default(uuid())
  examId       String
  exam         Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  partNumber   Int // e.g. 1, 2, 3...
  name         String // e.g. "Part 1: Photographs", "Part 2: Question-Response"
  instructions String?        @db.Text
  audioPath    String? // Optional global audio file for the entire part
  sortOrder    Int            @default(1)
  questions    ExamQuestion[] // Part owns Questions strictly

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, partNumber])
  @@index([examId])
}

model Question {
  id             String         @id @default(uuid())
  content        String         @db.Text
  options        Json // Structured JSON for answer choices
  right_answer   String
  category       ExamCategory
  partNumber     Int? // General default Part Number classification (e.g. 1 for TOEIC Part 1)
  explanation    String?        @db.Text
  status         QuestionStatus @default(ACTIVE)
  topicNumber    Int?
  imagePath      String?
  audioPath      String?
  examParts      ExamQuestion[] // Joined to ExamPart through ExamQuestion
  lastEditedById String?
  lastEditedBy   Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model ExamQuestion {
  partId     String
  part       ExamPart @relation(fields: [partId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  // Position sequence within this specific Part
  sortOrder Int // e.g. 1, 2, 3...

  @@id([partId, questionId])
  @@index([questionId])
}

model ExamHistory {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  examId           String
  exam             Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  score            Int
  totalQuestions   Int
  correctQuestions Int
  isPassed         Boolean
  answers          Json // Store user answers AND question snapshots
  startedAt        DateTime
  submittedAt      DateTime
  timeTakenSeconds Int
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([examId])
}

// ==========================================
// --- FLASHCARDS MODELS ---
// ==========================================

model Deck {
  id          String         @id @default(uuid())
  name        String
  description String?        @db.Text
  category    ExamCategory
  status      DeckStatus     @default(ACTIVE)
  visibility  DeckVisibility @default(PRIVATE)

  creatorId String?
  creator   User?   @relation("DeckCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  cards        Flashcard[]
  progressions UserDeckProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
}

model Flashcard {
  id           String    @id @default(uuid())
  deckId       String
  deck         Deck      @relation(fields: [deckId], references: [id], onDelete: Cascade)
  frontContent String    @db.Text
  backContent  String    @db.Text
  explanation  String?   @db.Text
  imagePath    String?
  audioPath    String?
  partNumber   Int? // Optional segment context (e.g. TOEIC context rules)

  status DeckStatus @default(ACTIVE)

  creatorId String?
  creator   User?   @relation("FlashcardCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  userProgresses FlashcardProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deckId])
  @@index([creatorId])
}

model FlashcardProgress {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcardId  String
  flashcard    Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  box          BoxLevel @default(BOX_1)
  intervalDays Int      @default(1)
  easeFactor   Float    @default(2.5)
  repetitions  Int      @default(0)

  nextReviewAt   DateTime  @default(now())
  lastReviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, flashcardId])
  @@index([userId, nextReviewAt])
}

model UserDeckProgress {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deckId           String
  deck             Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)

  totalCardsViewed Int      @default(0)
  masteredCards    Int      @default(0)
  lastStudiedAt    DateTime @default(now())

  @@unique([userId, deckId])
}

// ==========================================
// --- ROLE & PERMISSION MODELS ---
// ==========================================

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique @db.VarChar(50)
  description String?      @db.Text
  permissions Permission[]
  users       User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id         Int             @id @default(autoincrement())
  roleId     Int
  role       Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  resource   String
  scope      PermissionScope
  permission PermissionAction
  allowed    Boolean         @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, scope, permission, resource])
}

// ==========================================
// --- NEWS & ANNOUNCEMENT MODELS ---
// ==========================================

model News {
  id          String            @id @default(uuid())
  title       String
  slug        String            @unique
  summary     String?           @db.Text
  content     String            @db.Text
  thumbnail   String?
  category    NewsCategory      @default(GENERAL)
  status      NewsStatus        @default(DRAFT)
  viewsCount  Int               @default(0)
  authorName  String?           @default("Admin")
  tags        NewsTagRelation[]

  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, publishedAt])
}

model NewsTag {
  id        Int               @id @default(autoincrement())
  name      String            @unique @db.VarChar(50)
  slug      String            @unique
  news      NewsTagRelation[]

  createdAt DateTime          @default(now())
}

model NewsTagRelation {
  newsId String
  news   News    @relation(fields: [newsId], references: [id], onDelete: Cascade)
  tagId  Int
  tag    NewsTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([newsId, tagId])
  @@index([tagId])
}

// ==========================================
// --- CHAT MODELS ---
// ==========================================

model ChatChannel {
  id          String        @id @default(uuid())
  name        String        @db.VarChar(100)
  description String?       @db.Text
  icon        String?       // Optional channel icon/emoji
  status      ChannelStatus @default(ACTIVE)

  messages    ChatMessage[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ChatMessage {
  id        String      @id @default(uuid())
  channelId String
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  
  senderId  String
  sender    User        @relation(fields: [senderId], references: [id], onDelete: Cascade)

  content     String   @db.Text
  attachments String[] // Array of file/image URLs

  // Support for nested replies (Threading)
  parentId  String?
  parent    ChatMessage?  @relation("MessageReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies   ChatMessage[] @relation("MessageReplies")

  isEdited  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([channelId, createdAt])
  @@index([senderId])
}

// ==========================================
// --- FORUM MODELS ---
// ==========================================

model ForumCategory {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.Text
  icon        String?  // URL or icon identifier
  isPrivate   Boolean  @default(false)

  posts       ForumPost[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ForumPost {
  id          String        @id @default(uuid())
  title       String        @db.VarChar(255)
  slug        String        @unique @db.VarChar(255)
  content     String        @db.Text
  attachments String[]      // Array of image/file URLs
  status      PostStatus    @default(PUBLISHED)
  
  isPinned    Boolean       @default(false)
  isLocked    Boolean       @default(false) // Prevents new comments

  // Aggregated Counters for fast queries & ranking algorithms
  viewsCount    Int         @default(0)
  upvotesCount  Int         @default(0)
  downvotesCount Int        @default(0)
  commentsCount Int         @default(0)

  // Relations
  categoryId  String
  category    ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  authorId    String
  author      User          @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  comments    ForumComment[]
  votes       ForumPostVote[]
  savedBy     SavedPost[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([categoryId])
  @@index([authorId])
  @@index([createdAt])
  @@index([upvotesCount, createdAt]) // Helps with "Hot" / "Top" sorting queries
}

model ForumComment {
  id          String     @id @default(uuid())
  content     String     @db.Text
  isEdited    Boolean    @default(false)
  
  // Counters for comment scoring
  upvotesCount  Int      @default(0)
  downvotesCount Int     @default(0)

  // Relations
  postId      String
  post        ForumPost  @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId    String
  author      User       @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  // Nested Threading (Parent-Child Comment relationship)
  parentId    String?
  parent      ForumComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     ForumComment[] @relation("CommentReplies")

  votes       ForumCommentVote[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([postId])
  @@index([authorId])
  @@index([parentId])
}

model ForumPostVote {
  id        String   @id @default(uuid())
  type      VoteType

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId    String
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())

  @@unique([userId, postId]) // A user can vote on a post only once
  @@index([postId])
}

model ForumCommentVote {
  id        String       @id @default(uuid())
  type      VoteType

  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  commentId String
  comment   ForumComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime     @default(now())

  @@unique([userId, commentId]) // A user can vote on a comment only once
  @@index([commentId])
}

model SavedPost {
  id        String    @id @default(uuid())

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId    String
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())

  @@unique([userId, postId])
  @@index([userId])
}
